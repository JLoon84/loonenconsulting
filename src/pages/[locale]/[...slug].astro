---
import SiteLayout from "../../layouts/SiteLayout.astro";
import HomePage from "../../components/HomePage.astro";
import ServicesPage from "../../components/ServicesPage.astro";
import AboutPage from "../../components/AboutPage.astro";

// UPDATED: Import the dedicated Contact page.
import ContactPage from "../../components/ContactPage.astro";

import {
  locales,
  pagePath,
  site,
  type Locale,
  type Page,
} from "../../data/site";

const pageTitles: Record<Locale, Record<Page, string>> = {
  en: {
    home: "Loonen Consulting",
    services: "Services & approach",
    about: "About Janne",
    insights: "Insights",
    contact: "Contact",
  },
  de: {
    home: "Loonen Consulting",
    services: "Leistungen & Vorgehen",
    about: "Über Janne",
    insights: "Einblicke",
    contact: "Kontakt",
  },
  "pt-BR": {
    home: "Loonen Consulting",
    services: "Serviços e abordagem",
    about: "Sobre Janne",
    insights: "Artigos",
    contact: "Contato",
  },
};

const pageDescriptions: Record<Locale, Record<Page, string>> = {
  en: {
    home: "Independent consulting for German Mittelstand companies evaluating renewable energy opportunities in Northeast Brazil.",
    services: "Explore the areas of work Loonen Consulting can support as your company evaluates Northeast Brazil.",
    about: "Learn about Janne Loonen’s international project experience and connection to Northeast Brazil.",
    insights: "Articles and analysis by Janne Loonen on renewable energy and business questions in Northeast Brazil.",
    contact: "Start a focused conversation about your company’s interest in Northeast Brazil.",
  },
  de: {
    home: "Unabhängige Beratung für deutsche Mittelstandsunternehmen, die erneuerbare Energiemärkte im Nordosten Brasiliens prüfen.",
    services: "Erfahren Sie, wobei Loonen Consulting Ihr Unternehmen bei der Bewertung des Nordostens Brasiliens unterstützen kann.",
    about: "Erfahren Sie mehr über Janne Loonens internationale Projekterfahrung und ihre Verbindung zum Nordosten Brasiliens.",
    insights: "Beiträge und Analysen von Janne Loonen zu erneuerbaren Energien und Geschäftsmöglichkeiten im Nordosten Brasiliens.",
    contact: "Sprechen Sie mit Janne über das Interesse Ihres Unternehmens am Nordosten Brasiliens.",
  },
  "pt-BR": {
    home: "Consultoria independente para empresas alemãs de médio porte que avaliam oportunidades de energia renovável no Nordeste do Brasil.",
    services: "Conheça as áreas em que a Loonen Consulting pode apoiar sua empresa na avaliação do Nordeste do Brasil.",
    about: "Saiba mais sobre a experiência internacional de Janne Loonen e sua conexão com o Nordeste do Brasil.",
    insights: "Artigos e análises de Janne Loonen sobre energia renovável e negócios no Nordeste do Brasil.",
    contact: "Converse com Janne sobre o interesse da sua empresa no Nordeste do Brasil.",
  },
};

// UPDATED: Only Insights still needs an empty-state message.
const insightsMessages = {
  en: "Janne’s articles are being prepared for publication here.",
  de: "Jannes Beiträge werden für die Veröffentlichung hier vorbereitet.",
  "pt-BR": "Os artigos de Janne estão sendo preparados para publicação aqui.",
} as const;

export function getStaticPaths() {
  return locales.flatMap((locale) => {
    const pages = Object.keys(site[locale].pages) as Page[];
    const folder = locale === "pt-BR" ? "pt-br" : locale;

    return pages.map((page) => {
      const fullPath = pagePath(locale, page);
      const slug = fullPath
        .split("/")
        .slice(1)
        .filter(Boolean)
        .join("/");

      return {
        params: {
          locale: folder,
          slug: slug || undefined,
        },
        props: { locale, page },
      };
    });
  });
}

interface Props {
  locale: Locale;
  page: Page;
}

const { locale, page } = Astro.props;
const localeData = site[locale];

const navigation = localeData.navigation.map((item) => ({
  label: item.label,
  href: pagePath(locale, item.page as Page),
}));

const languageLinks = locales.map((language) => ({
  label: site[language].code,
  href: pagePath(language, page),
  current: language === locale,
}));
---

<SiteLayout
  lang={localeData.lang}
  title={`${pageTitles[locale][page]} | Loonen Consulting`}
  description={pageDescriptions[locale][page]}
  canonicalPath={pagePath(locale, page)}
  homePath={pagePath(locale, "home")}
  homeLabel={localeData.homeLabel}
  skipLabel={localeData.skipLabel}
  languageLabel={localeData.languageLabel}
  navigation={navigation}
  languageLinks={languageLinks}
>
  <!-- UPDATED: Contact now renders its dedicated component. -->
  {page === "home" ? (
    <HomePage locale={locale} />
  ) : page === "services" ? (
    <ServicesPage locale={locale} />
  ) : page === "about" ? (
    <AboutPage locale={locale} />
  ) : page === "contact" ? (
    <ContactPage locale={locale} />
  ) : (
    <section class="page-shell" aria-labelledby="page-title">
      <p class="eyebrow">{localeData.homeLabel}</p>
      <h1 id="page-title">{pageTitles[locale][page]}</h1>
      <p class="page-message">{insightsMessages[locale]}</p>
    </section>
  )}
</SiteLayout>

<style>
  /* UPDATED: These styles now apply only to the Insights empty state. */
  .page-shell {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 8rem) 0;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-teal);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    color: var(--color-teal);
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .page-message {
    max-width: 42rem;
    margin-top: 2rem;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }
</style>