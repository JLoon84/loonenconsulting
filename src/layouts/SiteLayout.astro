---
import "../styles/global.css";

interface LanguageLink {
  label: "EN" | "DE" | "PT-BR";
  href: string;
  current?: boolean;
}

interface Props {
  noindex?: boolean;
  lang: "en" | "de" | "pt-BR";
  title: string;
  description: string;
  canonicalPath: string;
  homePath: string;
  homeLabel: string;
  skipLabel: string;
  languageLabel: string;
  languageLinks: LanguageLink[];
}

const {
  noindex = false,
  lang,
  title,
  description,
  canonicalPath,
  homePath,
  homeLabel,
  skipLabel,
  languageLabel,
  languageLinks,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const legalPage = {
  en: { href: "en/legal-notice/", label: "Legal notice" },
  de: { href: "de/impressum/", label: "Impressum" },
  "pt-BR": { href: "pt-br/informacoes-legais/", label: "Informações legais" },
}[lang];

const canonical = Astro.site
  ? new URL(withBase(canonicalPath), Astro.site)
  : undefined;

// UPDATED: Flags represent the available website languages.
// Full language names remain available to assistive technology.
const languageOptions = {
  EN: {
    flag: "🇬🇧",
    name: "English",
    lang: "en",
  },
  DE: {
    flag: "🇩🇪",
    name: "Deutsch",
    lang: "de",
  },
  "PT-BR": {
    flag: "🇧🇷",
    name: "Português do Brasil",
    lang: "pt-BR",
  },
} as const;

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F5F2" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>

  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>

    <header class="site-header">
      <a class="wordmark" href={withBase(homePath)}><img src={withBase("images/loonen.svg")} alt={homeLabel} width="250" height="90" /></a>


      <!-- UPDATED: Flag links replace the visible language abbreviations. -->
      <nav class="language-nav" aria-label={languageLabel}>
        {languageLinks.map((language) => {
          const option = languageOptions[language.label];

          return (
            <a
              href={withBase(language.href)}
              lang={option.lang}
              hreflang={option.lang}
              aria-label={option.name}
              title={option.name}
              aria-current={language.current ? "page" : undefined}
            >
              <span class="language-flag" aria-hidden="true">
                {option.flag}
              </span>
            </a>
          );
        })}
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-contact">
        <a href="mailto:info@loonenconsulting.com">info@loonenconsulting.com</a>
        <a href={withBase(legalPage.href)}>{legalPage.label}</a>
      </div>
      <span>© {new Date().getFullYear()} Loonen Consulting</span>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: 1rem;
    z-index: 2;
    padding: 0.65rem 0.9rem;
    transform: translateY(-200%);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header,
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem max(1.25rem, calc((100% - 72rem) / 2));
  }

  .site-header {
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-border);
    background: white;
  }

  .wordmark img { display: block; width: clamp(150px, 22vw, 250px); height: auto; }

  .wordmark {
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }



  /* UPDATED: Keep flag controls together with generous click targets. */
  .language-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .language-nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.25rem;
    border-bottom: 3px solid transparent;
    text-decoration: none;
  }

  .language-flag {
    font-family:
      "Apple Color Emoji",
      "Segoe UI Emoji",
      "Noto Color Emoji",
      sans-serif;
    font-size: 1.65rem;
    line-height: 1;
  }

  .language-nav a:hover {
    background: var(--color-surface);
  }

  /* UPDATED: An underline identifies the current language without colour alone. */
  .language-nav a[aria-current="page"] {
    border-bottom-color: var(--color-ink);
  }

  .footer-contact { display:flex; flex-wrap:wrap; gap:.6rem 1.25rem; }
  .site-footer {
    flex-wrap:wrap;
    font-size:.9rem;
    margin-top: 4rem;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 760px) {
    .site-header { align-items:center; gap:.75rem; }
    .language-nav { margin-left:auto; }
  }
</style>
