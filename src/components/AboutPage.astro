---
// NEW: Dedicated component for the localized About page.
import { aboutContent } from "../data/about";
import { pagePath, type Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const about = aboutContent[locale];

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
---

<header class="about-header">
  <p class="eyebrow">Loonen Consulting</p>
  <h1>{about.title}</h1>
  <p class="introduction">{about.introduction}</p>
</header>

<div class="about-content">
  {about.sections.map((section, index) => (
    <section
      class="biography-section"
      aria-labelledby={`biography-heading-${index}`}
    >
      <h2 id={`biography-heading-${index}`}>{section.title}</h2>
      <p>{section.text}</p>
    </section>
  ))}

  <section class="languages-section" aria-labelledby="languages-heading">
    <h2 id="languages-heading">{about.languagesTitle}</h2>
    <p>{about.languagesIntroduction}</p>

    <ul class="language-list">
      {about.languages.map((language) => (
        <li>{language}</li>
      ))}
    </ul>
  </section>
</div>

<section class="contact-section" aria-labelledby="about-contact-heading">
  <div class="contact-inner">
    <h2 id="about-contact-heading">{about.contactTitle}</h2>
    <p>{about.contactText}</p>
    <a class="contact-link" href={withBase(pagePath(locale, "contact"))}>
      {about.contactLink}
    </a>
  </div>
</section>

<style>
  /* NEW: Scoped styles for the text-led About page. */
  .about-header {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-teal);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--color-teal);
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .introduction {
    max-width: 48rem;
    margin: 1.75rem 0 0;
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
  }

  .about-content {
    width: min(100% - 2.5rem, 68rem);
    margin: 0 auto;
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .biography-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding-block: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  h2 {
    margin: 0 0 1rem;
    color: var(--color-teal);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .biography-section p {
    margin: 0;
    max-width: 65ch;
  }

  .languages-section {
    padding-top: 2.5rem;
    border-top: 3px solid var(--color-orange);
  }

  .language-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 1.5rem 0 0;
    padding-left: 1.25rem;
  }

  .language-list li {
    padding-right: 0.5rem;
  }

  .contact-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    background: #eeebe7;
  }

  .contact-inner {
    width: min(100% - 2.5rem, 68rem);
    margin: 0 auto;
  }

  .contact-inner h2,
  .contact-inner p {
    max-width: 48rem;
  }

  .contact-link {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.8rem 1.1rem;
    border-radius: 2px;
    background: var(--color-teal);
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .contact-link:hover {
    background: var(--color-burgundy);
    color: white;
  }

  @media (max-width: 760px) {
    .biography-section {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>