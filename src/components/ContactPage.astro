---
// NEW: Dedicated component for the localized Contact page.
import { contactContent, contactEmail } from "../data/contact";
import type { Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const contact = contactContent[locale];
const emailHref = `mailto:${contactEmail}`;
---

<header class="contact-header">
  <p class="eyebrow">Loonen Consulting</p>
  <h1>{contact.title}</h1>
  <p class="introduction">{contact.introduction}</p>
</header>

<div class="contact-content">
  <section class="email-section" aria-labelledby="email-heading">
    <h2 id="email-heading">{contact.emailLabel}</h2>

    <a class="email-address" href={emailHref}>
      {contactEmail}
    </a>

    <p class="email-help">{contact.emailHelp}</p>
  </section>

  <section class="guidance-section" aria-labelledby="guidance-heading">
    <h2 id="guidance-heading">{contact.guidanceTitle}</h2>
    <p class="guidance-introduction">{contact.guidanceIntroduction}</p>

    <dl class="message-prompts">
      {contact.prompts.map((prompt) => (
        <div class="message-prompt">
          <dt>{prompt.title}</dt>
          <dd>{prompt.text}</dd>
        </div>
      ))}
    </dl>

    <p class="closing">{contact.closing}</p>
  </section>
</div>

<style>
  /* NEW: Scoped styles for the Contact page. */
  .contact-header {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-teal);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 20ch;
    margin: 0;
    color: var(--color-teal);
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.08;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .introduction {
    max-width: 48rem;
    margin: 1.75rem 0 0;
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
  }

  .contact-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(2rem, 6vw, 5rem);
    width: min(100% - 2.5rem, 68rem);
    margin: 0 auto;
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .email-section,
  .guidance-section {
    min-width: 0;
    padding-top: 1.5rem;
    border-top: 3px solid var(--color-orange);
  }

  h2 {
    margin: 0 0 1rem;
    color: var(--color-teal);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .email-address {
    display: inline-block;
    max-width: 100%;
    padding-block: 0.75rem;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .email-help {
    max-width: 38ch;
    margin-top: 0.75rem;
    font-size: 0.95rem;
  }

  .guidance-introduction {
    margin: 0 0 2rem;
    max-width: 60ch;
  }

  .message-prompts {
    margin: 0;
  }

  .message-prompt {
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .message-prompt dt {
    margin-bottom: 0.4rem;
    font-weight: 700;
  }

  .message-prompt dd {
    margin: 0;
    max-width: 60ch;
  }

  .closing {
    max-width: 60ch;
    margin: 2rem 0 0;
  }

  @media (max-width: 760px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>