---
// NEW: Services rendering and styles extracted from the route template.
import { servicesContent } from "../data/services";
import { pagePath, site, type Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const services = servicesContent[locale];
const localeData = site[locale];

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const serviceLabels = {
  en: {
    when: "When it is relevant",
    work: "The work involved",
    deliverable: "What the work provides",
  },
  de: {
    when: "Wann es sinnvoll ist",
    work: "Was die Arbeit umfasst",
    deliverable: "Was die Arbeit liefert",
  },
  "pt-BR": {
    when: "Quando faz sentido",
    work: "O que o trabalho envolve",
    deliverable: "O que o trabalho oferece",
  },
} as const;

const labels = serviceLabels[locale];
---

<section class="page-shell" aria-labelledby="page-title">
  <p class="eyebrow">{localeData.homeLabel}</p>
  <h1 id="page-title">{services.title}</h1>
  <p class="hero-intro">{services.introduction}</p>
</section>

<div class="content-inner service-details">
  {services.services.map((service, index) => (
    <section
      class="service-detail"
      aria-labelledby={`service-title-${index}`}
    >
      <div>
        <h2 id={`service-title-${index}`}>{service.title}</h2>
        <p class="service-question">{service.question}</p>
      </div>

      <dl>
        <dt>{labels.when}</dt>
        <dd>{service.when}</dd>

        <dt>{labels.work}</dt>
        <dd>{service.work}</dd>

        <dt>{labels.deliverable}</dt>
        <dd>{service.deliverable}</dd>
      </dl>
    </section>
  ))}
</div>

<section class="approach-section" aria-labelledby="approach-title">
  <div class="content-inner">
    <h2 id="approach-title">{services.approachTitle}</h2>
    <p>{services.approachText}</p>
    <a class="primary-link" href={withBase(pagePath(locale, "contact"))}>
      {services.contactLink}
    </a>
  </div>
</section>

<style>
  /* NEW: These scoped styles now belong to the Services component. */
  .page-shell {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 8rem) 0;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-teal);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    color: var(--color-teal);
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .hero-intro {
    max-width: 48rem;
    margin: 1.75rem 0 2rem;
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
  }

  .content-inner {
    width: min(100% - 2.5rem, 68rem);
    margin: 0 auto;
  }

  .service-details {
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .service-detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding-block: 2.5rem;
    border-top: 2px solid var(--color-orange);
  }

  .service-detail h2 {
    margin: 0 0 1rem;
    color: var(--color-teal);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .service-question {
    font-weight: 700;
  }

  .service-detail dl {
    margin: 0;
  }

  .service-detail dt {
    margin-bottom: 0.35rem;
    font-weight: 700;
  }

  .service-detail dd {
    margin: 0 0 1.5rem;
  }

  .service-detail dd:last-child {
    margin-bottom: 0;
  }

  .approach-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    background: #eeebe7;
  }

  .approach-section h2 {
    max-width: 24ch;
    margin: 0 0 1.25rem;
    color: var(--color-teal);
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  .approach-section p {
    max-width: 54rem;
  }

  .primary-link {
    display: inline-block;
    padding: 0.8rem 1.1rem;
    border-radius: 2px;
    background: var(--color-teal);
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .primary-link:hover {
    background: var(--color-burgundy);
    color: white;
  }

  @media (max-width: 760px) {
    .service-detail {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>