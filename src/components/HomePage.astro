---
import ContactActions from "./ContactActions.astro";
import { homeContent } from "../data/home";
import { type Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = homeContent[locale];
---

<section
  class="home-hero"
  aria-labelledby="page-title"
  style={`--hero-image: url("${import.meta.env.BASE_URL}images/home-header.webp")`}
>
  <p class="eyebrow">{home.eyebrow}</p>
  <h1 id="page-title">
    {home.titleLines.map((line, index) => (
      <span>{line}{index === 0 && " "}</span>
    ))}
  </h1>
  <p class="hero-intro">{home.introduction}</p>
  <ContactActions locale={locale} compact />
</section>

<section
  class="content-section decision-section"
  aria-labelledby="decision-title"
>
  <div class="content-inner">
    <h2 id="decision-title">{home.decisionTitle}</h2>
    <p>{home.decisionText}</p>
  </div>
</section>

<section
  class="content-section audience-section"
  aria-labelledby="audience-title"
>
  <div class="content-inner">
    <h2 id="audience-title">{home.audienceTitle}</h2>
    <p>{home.audienceText}</p>
  </div>
</section>

<section
  id="services"
  class="content-section services-section"
  aria-labelledby="services-title"
>
  <div class="content-inner">
    <h2 id="services-title">{home.servicesTitle}</h2>
    <div class="service-list">
      {home.services.map((service) => (
        <article class="service-item">
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section
  id="about"
  class="content-section about-section"
  aria-labelledby="about-title"
>
  <div class="about-layout">
    <div class="about-copy">
      <h2 id="about-title">{home.aboutTitle}</h2>
      <h3 class="about-name">{home.aboutName}</h3>
      <p class="about-role">{home.aboutRole}</p>
      <p>{home.aboutText}</p>
      <p>{home.aboutLanguages}</p>
    </div>

    <img
      class="about-portrait"
      src={`${import.meta.env.BASE_URL}images/janne-loonen.webp`}
      alt={home.aboutName}
      width="900"
      height="600"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<section
  id="contact"
  class="content-section contact-section"
  aria-labelledby="contact-title"
>
  <div class="content-inner">
    <h2 id="contact-title">{home.contactTitle}</h2>
    <p>{home.contactText}</p>
    <ContactActions locale={locale} />
  </div>
</section>

<style>
  .home-hero {
    width: 100%;
    margin: 0;
    padding: clamp(4rem, 9vw, 8rem)
      max(1.25rem, calc((100% - 72rem) / 2));
    position: relative;
    isolation: isolate;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-teal);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 100%;
    margin: 0;
    color: var(--color-teal);
    font-size: clamp(1.9rem, 4.5vw, 4rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  h1 span {
    display: block;
  }

  .home-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(
        90deg,
        rgba(247, 245, 242, .96) 0%,
        rgba(247, 245, 242, .90) 44%,
        rgba(247, 245, 242, .25) 100%
      ),
      var(--hero-image);
    background-size: cover;
    background-position: center, center right;
  }

  .about-name {
    font-size: 1.6rem;
    margin-bottom: .25rem;
    color: var(--color-teal);
  }

  .about-role {
    margin-top: 0;
    font-weight: 700;
  }

  .hero-intro {
    max-width: 48rem;
    margin: 1.75rem 0 2rem;
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
  }

  .content-inner {
    width: min(100% - 2.5rem, 68rem);
    margin: 0 auto;
  }

  .content-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .services-section {
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .about-section {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .content-section h2 {
    max-width: 24ch;
    margin: 0 0 1.25rem;
    color: var(--color-teal);
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  .content-section p {
    max-width: 54rem;
  }

  .decision-section {
    background: var(--color-surface);
  }

  .about-layout {
    width: min(100% - 2.5rem, 68rem);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, .85fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .about-copy {
    min-width: 0;
  }

  .about-portrait {
    display: block;
    width: min(100%, 320px);
    height: auto;
    aspect-ratio: 1 / 1;
    justify-self: end;
    border: 1px solid var(--color-border);
    border-radius: 50%;

    object-fit: cover;
    object-position: center;
  }

  .service-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .service-item {
    padding-top: 1rem;
    border-top: 3px solid var(--color-orange);
  }

  .service-item h3 {
    margin-bottom: 0.75rem;
    color: var(--color-ink);
  }

  .service-question {
    font-weight: 700;
  }

  .primary-link {
    display: inline-block;
    padding: 0.8rem 1.1rem;
    border-radius: 2px;
    background: var(--color-copper);
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: none;
  }

  .primary-link:hover {
    background: var(--color-brown);
    color: var(--color-paper);
  }

  .contact-section {
    background: var(--color-teal);
    color: white;
    --call-background: var(--color-copper);
    --call-color: var(--color-ink);
    --call-hover: var(--color-paper);
  }

  .contact-section h2 {
    color: white;
  }

  @media (max-width: 480px) {
    h1 {
      font-size: clamp(1.4rem, 5.8vw, 1.9rem);
    }
  }

  @media (max-width: 760px) {
    .home-hero::before {
      background-image:
        linear-gradient(
          rgba(247, 245, 242, .88),
          rgba(247, 245, 242, .88)
        ),
        var(--hero-image);
      background-position: center;
    }

    .about-layout {
      grid-template-columns: 1fr;
    }

    .about-portrait {
      width: min(100%, 320px);
      justify-self: start;
    }

    .service-list {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>